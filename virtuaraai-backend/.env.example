# Django
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://virtuara_user:virtuara_pass@localhost:5432/virtuara_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Virtuara AI <noreply@virtuara.ai>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3002

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Server-side AI text provider
# Supported: openai, groq, openai-compatible
VIRTUARA_TEXT_PROVIDER=
VIRTUARA_TEXT_PROVIDER_API_KEY=
# Required for openai-compatible; optional override for openai/groq
VIRTUARA_TEXT_PROVIDER_BASE_URL=
# Required for openai-compatible; optional override for openai/groq
VIRTUARA_TEXT_PROVIDER_MODEL=
VIRTUARA_TEXT_PROVIDER_TIMEOUT_SECONDS=15
VIRTUARA_CONCISE_RESPONSE_MAX_TOKENS=450
VIRTUARA_DETAILED_RESPONSE_MAX_TOKENS=900
VOICE_TURN_RATE_LIMIT=30/min
